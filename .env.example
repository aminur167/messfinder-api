# Copy this file to ".env" and put your own values. The real .env file must never be pushed to GitHub.

# Server
PORT=5000
# The websites allowed to call this API, separated by commas
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mess_finder

# Login tokens
JWT_SECRET=change_this_to_a_long_random_text
JWT_EXPIRES_IN=7d
